rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Global orders collection for studio administration & sales reporting
    match /orders/{orderId} {
      allow read, write: if isSignedIn() && isValidId(orderId);
    }

    // Ingredients inventory collection
    match /ingredients/{ingredientId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(ingredientId);
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      match /orders/{orderId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(orderId);
      }

      match /blends/{blendId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(blendId);
      }
    }
  }
}
